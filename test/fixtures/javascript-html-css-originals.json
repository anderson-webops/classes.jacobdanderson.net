    {
      "project": "html-css-basics",
      "role": "reference",
      "url": "https://codepen.io/junilearning/pen/d14dd0596bbb8720c359688f460c9419",
      "resolvedURL": "https://codepen.io/junilearning/pen/rNOWGoB/d14dd0596bbb8720c359688f460c9419",
      "panels": {
        "HTML": "<!-- \nPrompt\n\n1. Make a div tag with your first name and a div tag with your last name \n\n2. Make a div tag, then a span tag as a child with your first name and then a span tag with your last name\n\n3. Make a div tag with your first name, a br tag, and then a div tag with your last name\n\n4. Make an img tag and find an image online that you want to add to your page\n\n5. Make an anchor tag and link it to wikipedia.org\n\n6. Use a CSS selector to target body and change the background-color to your favorite color\n\n7. Use a CSS selector to target div and set text-align to center\n\n8. Use a CSS selector to target span and set font-size to 20px\n\n9. Use a CSS selector to target img and set height to 200px and width to 200px\n\n10. Use a CSS selector to target div and set font-weight to bold. What happens when you target span and set font-weight to normal?\n-->\n\n<!-- Solution -->\n\n<div>Alan</div>\n<div>Turing</div>\n\n<div>\n  <span>Alan</span>\n  <span>Turing</span>\n</div>\n\n\n<div>Alan</div>\n<br>\n<div>Turing</div>\n<div>\n  <img src=\"https://gravatar.com/avatar/e1b5510028a6a3003f300538bd504f0d?d=https%3A%2F%2Fassets.codepen.io%2Finternal%2Favatars%2Fusers%2Fdefault.png&format=auto&height=80&version=0&width=80\" alt=\"#\">\n</div>\n<br>\n<div>\n  <a href=\"wikipedia.org\">Go To Wikipedia</a>\n</div>\n\n\n",
        "CSS": "/* Solution */\n\ndiv {\n  text-align: center;\n  font-weight: bold;\n}\nspan {\n  font-size: 20px;\n  font-weight: normal;\n}\nimg {\n  width: 200px;\n  height: 200px;\n}\nbody {\n  background-color: peru;\n}",
        "JavaScript": ""
      },
