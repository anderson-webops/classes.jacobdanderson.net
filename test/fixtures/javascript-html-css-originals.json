      "panels": {
        "HTML": "<h1>Block Display</h1>\n<div class=\"box-block box-red\"></div>\n<div class=\"box-block box-orange\"></div>\n<div class=\"box-block box-yellow\"></div>\n<div class=\"box-block box-green\"></div>\n<div class=\"box-block box-blue\"></div>\n<div class=\"box-block box-purple\"></div>\n\n<h1>Inline Block Display</h1>\n<div class=\"box-inline-block box-red\"></div>\n<div class=\"box-inline-block box-orange\"></div>\n<div class=\"box-inline-block box-yellow\"></div>\n<div class=\"box-inline-block box-green\"></div>\n<div class=\"box-inline-block box-blue\"></div>\n<div class=\"box-inline-block box-purple\"></div>\n\n<h1>Grid</h1>\n<!-- Works because the wrapping divs are display: block by default -->\n<div>\n  <div class=\"box-inline-block box-red\"></div>\n  <div class=\"box-inline-block box-orange\"></div>\n</div>\n<div>\n  <div class=\"box-inline-block box-yellow\"></div>\n  <div class=\"box-inline-block box-green\"></div>\n</div>\n<div>\n  <div class=\"box-inline-block box-blue\"></div>\n  <div class=\"box-inline-block box-purple\"></div>\n</div>\n\n<h1>Table</h1>\n<table>\n  <tr>\n    <td>\n      <div class=\"box-inline-block box-red\"></div>\n    </td>\n    <td>\n      <div class=\"box-inline-block box-orange\"></div>\n    </td>\n  </tr>\n  <tr>\n    <td>\n      <div class=\"box-inline-block box-yellow\"></div>\n    </td>\n    <td>\n      <div class=\"box-inline-block box-green\"></div>\n    </td>\n  </tr>\n  <tr>\n    <td>\n      <div class=\"box-inline-block box-blue\"></div>\n    </td>\n    <td>\n      <div class=\"box-inline-block box-purple\"></div>\n    </td>\n  </tr>\n</table>",
        "CSS": ".box-block {\n  width: 50px;\n  height: 50px;\n  display: block;\n}\n\n.box-inline-block {\n  width: 50px;\n  height: 50px;\n  display: inline-block;\n}\n\n.box-red {\n  background-color: red;\n}\n\n.box-orange {\n  background-color: orange;\n}\n\n.box-yellow {\n  background-color: yellow;\n}\n\n.box-green {\n  background-color: green;\n}\n\n.box-blue {\n  background-color: blue;\n}\n\n.box-purple {\n  background-color: purple;\n}\n",
        "JavaScript": ""
      },
