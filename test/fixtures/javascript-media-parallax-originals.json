      "panels": {
        "HTML": "<nav class=\"yellow darken-1\" role=\"navigation\">\n  <div class=\"nav-wrapper container\">\n    <div class=\"brand-logo center\">\n      Yellowstone National Park\n    </div>\n  </div>\n</nav>\n<div class=\"parallax-container\">\n  <div class=\"parallax\"><img src=\"https://jacksonholewildlifesafaris.com/wp-content/uploads/2019/09/yellowstone-waterfall-hero-720x405@2x.jpg\"></div>\n</div>\n<div class=\"section yellow darken-1\">\n  <div class=\"row container\">\n    <h4 class=\"header white-text\">General Information</h4>\n    <p class=\"white-text\">Yellowstone National Park is a nearly 3,500-sq.-mile wilderness recreation area atop a volcanic hot spot. Mostly in Wyoming, the park spreads into parts of Montana and Idaho too.</p>\n    <h4 class=\"header white-text\">Flora and Fauna</h4>\n    <p class=\"white-text right\">Yellowstone features dramatic canyons, alpine rivers, lush forests, hot springs and gushing geysers, including its most famous, Old Faithful. It's also home to hundreds of animal species, including bears, wolves, bison, elk and antelope.</p>\n  </div>\n</div>\n<div class=\"parallax-container\">\n  <div class=\"parallax\"><img src=\"https://gypsyguide.com/wp-content/uploads/2017/09/Yellowstone-and-Grand-Teton-National-Park-Tours-1.jpg\"></div>\n</div>\n<div class=\"page-footer yellow darken-1\">\n  <div class=\"container\">\n    <h5>Book a Trip today!</h5>\n    <p>(807) 979-9797</p>\n    <p>info@yellowstone.com</p>\n    <br>\n  </div>\n</div>",
        "CSS": "body {\n  margin: 0px;\n}",
