		"panels": {
			"HTML": "<canvas id=\"my-canvas\"></canvas>",
			"CSS": "",
			"JavaScript": "// Use Canvas to draw a red square, a blue circle, and a green triangle! The degreesToRadians(degrees) function has been provided for you to help you draw an arc.\n\n// Solution\n\n// Resize Canvas\nconst canvas = document.getElementById(\"my-canvas\");\n\ncanvas.width = 1000;\ncanvas.height = 500;\n\nconst ctx = canvas.getContext(\"2d\");\n\n// square\nctx.fillStyle = \"rgba(255,0,0,0.5)\";\n// arguments: x, y, width, height\nctx.fillRect(100, 100, 100, 100);\n\n// circle\n// arguments: x, y, radius, startAngle (in radians), endAngle (in radians)\nctx.arc(300, 150, 50, 0, degreesToRadians(360));\nctx.fillStyle = \"rgba(0,0,255,0.5)\";\nctx.fill();\n\n// triangle\nctx.beginPath();\nctx.moveTo(500, 200);\nctx.lineTo(400, 200);\nctx.lineTo(500, 100);\nctx.fillStyle = \"rgba(0,255,0,0.5)\";\nctx.fill();\nctx.closePath();\n\n// DO NOT ALTER CODE WRITTEN BELOW THIS LINE\n\nfunction degreesToRadians(degrees) {\n  return degrees * Math.PI / 180;\n};"
		},
