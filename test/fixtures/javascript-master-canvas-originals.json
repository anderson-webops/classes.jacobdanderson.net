	{
		"project": "shining-stars",
		"role": "reference",
		"url": "https://codepen.io/junilearning/pen/425a78d7d054dfda21d4242e818f64ba",
		"title": "JSM4 Project 2: Shining Stars Solution",
		"observedURL": "https://codepen.io/junilearning/pen/XWKdRgM/425a78d7d054dfda21d4242e818f64ba",
		"panels": {
			"HTML": "<canvas id=\"my-canvas\"></canvas>",
			"CSS": "",
			"JavaScript": "// Use canvas to draw a gold star. Then, refactor your code to use a function to draw a star called drawStar(x, y) at the inputted x and y coordinates. Then, draw 5 stars using the drawStar(x, y) function.\n\nconst canvas = document.getElementById(\"my-canvas\");\n\ncanvas.width = window.innerWidth;\ncanvas.height = window.innerHeight;\n\nconst ctx = canvas.getContext(\"2d\");\n\nconst drawStar = (x, y) => {\n  ctx.beginPath();\n  ctx.moveTo(x, y);\n  ctx.lineTo(x + 50, y + 150);\n  ctx.lineTo(x - 75, y + 50);\n  ctx.lineTo(x + 75, y + 50);\n  ctx.lineTo(x - 50, y + 150);\n  ctx.lineTo(x, y);\n  ctx.fillStyle = \"gold\";\n  ctx.fill();\n}\n\nfor (let i = 1; i <= 5; i++) {\n  drawStar(200*i, 100);\n}\n"
		},
