		"panels": {
			"HTML": "<canvas id=\"my-canvas\"></canvas>",
			"CSS": "",
			"JavaScript": "// Prompt: Draw a landscape on your canvas with trees, the sun, a river, etc. Make this project your own and construct a work of art.\n\nconst canvas = document.getElementById(\"my-canvas\");\n\ncanvas.width = 800;\ncanvas.height = 800;\n\nconst ctx = canvas.getContext(\"2d\");\n\nctx.fillStyle = \"blue\";\nctx.fillRect(0, 0, 800, 500);\nctx.fillStyle = \"green\";\nctx.fillRect(0, 500, 800, 300);\n\nconst drawTree = (x, y) => {\n  ctx.beginPath();\n  ctx.moveTo(x, y);\n  ctx.lineTo(x+50, y-400);\n  ctx.lineTo(x+100, y);\n  ctx.lineTo(x, y);\n  ctx.closePath()\n  ctx.fillStyle = \"rgba(0,255,0)\";\n  ctx.fill();\n  ctx.fillStyle = \"brown\";\n  ctx.fillRect(x+40, y-50, 20, 250);\n}\n\ndrawTree(10, 600);\ndrawTree(110, 550);\ndrawTree(210, 600);\n\nctx.beginPath();\nctx.arc(600, 200, 100, 0, Math.PI * 2);\nctx.fillStyle = \"yellow\";\nctx.fill();"
		},
