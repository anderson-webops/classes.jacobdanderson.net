	{
		"project": "jni-stock-price",
		"role": "reference",
		"url": "https://codepen.io/junilearning/pen/1d48af84b840e8d7a72fd02e82de9f28",
		"title": "JSM4 Supplemental Project 2: JNI Stock Price Solution",
		"observedURL": "https://codepen.io/junilearning/pen/eYzgYQv/1d48af84b840e8d7a72fd02e82de9f28",
		"panels": {
			"HTML": "<canvas id=\"my-canvas\"></canvas>",
			"CSS": "",
			"JavaScript": "// Prompt: Draw a graph showing the performance of the JNI stock. Make an x-axis with dates and a y-axis with stock price labeled, and then draw JNI's performance over the period as a line.\n\nconst canvas = document.getElementById(\"my-canvas\");\n\ncanvas.width = 800;\ncanvas.height = 800;\n\nconst ctx = canvas.getContext(\"2d\");\n\nctx.beginPath()\nctx.strokeStyle = \"black\";\nctx.lineWidth = 5;\nctx.moveTo(200, 500);\nctx.lineTo(300, 300);\nctx.stroke()\nctx.lineTo(400, 450);\nctx.stroke()\nctx.lineTo(500, 350);\nctx.stroke()\nctx.lineTo(600, 250);\nctx.stroke()\n\nctx.beginPath()\nctx.lineWidth = 10;\nctx.moveTo(600, 600);\nctx.lineTo(200, 600);\nctx.lineTo(200, 200);\nctx.strokeStyle = \"grey\";\nctx.stroke()\n\nctx.font = \"40px Georgia\";\nctx.fillStyle = \"blue\";\nctx.textAlign = \"center\";\nctx.fillText(\"JNI\", 400, 150);\n\nctx.font = \"12px Georgia\";\nctx.fillStyle = \"black\";\nctx.textAlign = \"center\";\nfor (let i = 0; i <= 6; i += 1) {\n  ctx.fillText(`${i*100}`, 150, 600 - i*60);\n}\n\nctx.font = \"12px Georgia\";\nctx.fillStyle = \"black\";\nctx.textAlign = \"center\";\nfor (let i = 0; i <= 6; i += 1) {\n  ctx.fillText(`1/${i*3 + 1}`, 200 + i*60, 650);\n}"
		},
