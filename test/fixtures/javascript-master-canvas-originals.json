			"JavaScript": "// Use canvas to make a holiday card. Pick your favorite holiday and make a themed card. Make sure to use both shapes and text in your card.\n\nconst canvas = document.getElementById(\"my-canvas\");\n\ncanvas.width = 800;\ncanvas.height = 800;\n\nconst ctx = canvas.getContext(\"2d\");\n\nctx.fillStyle = \"#FFC0CB\";\nctx.fillRect(50, 0, 600, 400);\n\nctx.arc(305, 100, 55, 0, Math.PI * 2);\nctx.fillStyle = \"red\";\nctx.fill();\nctx.arc(395, 100, 55, 0, Math.PI * 2);\nctx.fill();\nctx.beginPath();\nctx.moveTo(260, 90);\nctx.lineTo(256, 125);\nctx.lineTo(350, 270);\nctx.lineTo(444, 125);\nctx.lineTo(440, 90);\nctx.fill();\n\nctx.font = \"40px Georgia\";\nctx.fillStyle = \"white\";\nctx.textAlign = \"center\";\nctx.fillText(\"Happy Valentine's Day!\", 350, 350);"
		},
