    {
      "project": "fake-tech",
      "role": "reference",
      "url": "https://codepen.io/junilearning/pen/cdf88ee56f7d30ee0b1eba24ae89353e",
      "observedURL": "https://codepen.io/junilearning/pen/jOboVaw/cdf88ee56f7d30ee0b1eba24ae89353e",
      "title": "JSS13 Supplemental Project 1: FakeTech.io Solution",
      "panels": {
        "HTML": "<!-- Your task is to make a company page which lists the company's employees. Make a circular image picture on a card as well as some text about the person at the company including their occupation. Make sure to make the cards pop by using a valign wrapper as well as a box-shadow with the hoverable class. Search the materialize docs in order to determine how to implement a valign wrapper, circular image, and a box-shadow. -->\n\n<!-- Solution -->\n\n<nav class=\"blue lighten-3\">\n  <div class=\"nav-wrapper\">\n    <div class=\"brand-logo center\">Our Employees at FakeTech.io</div>\n  </div>\n</nav>\n<br>\n<div class=\"container\">\n  <div class=\"card-panel grey lighten-5 z-depth-2 hoverable\">\n    <div class=\"row valign-wrapper\">\n      <div class=\"col s2\">\n        <img src=\"https://www.shareicon.net/data/256x256/2016/05/24/770107_man_512x512.png\" alt=\"\" class=\"circle responsive-img\"> <!-- notice the \"circle\" class -->\n      </div>\n      <div class=\"col s10\">\n        <div class=\"center black-text\">\n          Mark is the CEO of FakeTech.io, he is originally from the East Coast and moved to San Francisco for college. He loves to fish and golf!\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"card-panel grey lighten-5 z-depth-2 hoverable\">\n    <div class=\"row valign-wrapper\">\n      <div class=\"col s10\">\n        <div class=\"center black-text\">\n          Molly is the CTO of FakeTech.io, and she loves to code in Python and JavaScript! In her free time, she loves to play hockey and play video games!\n        </div>\n      </div>\n      <div class=\"col s2\">\n        <img src=\"https://www.shareicon.net/data/256x256/2016/05/24/770088_people_512x512.png\" alt=\"\" class=\"circle responsive-img\"> <!-- notice the \"circle\" class -->\n      </div>\n    </div>\n  </div>\n  <div class=\"card-panel grey lighten-5 z-depth-2 hoverable\">\n    <div class=\"row valign-wrapper\">\n      <div class=\"col s2\">\n        <img src=\"https://www.shareicon.net/data/256x256/2016/05/24/770105_man_512x512.png\" alt=\"\" class=\"circle responsive-img\"> <!-- notice the \"circle\" class -->\n      </div>\n      <div class=\"col s10\">\n        <div class=\"center black-text\">\n          Stefan is the CFO of FakeTech.io, and he has known Molly since High School. He loves to dine at nice restaurants and going skiing!\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"card-panel grey lighten-5 z-depth-2 hoverable\">\n    <div class=\"row valign-wrapper\">\n      <div class=\"col s10\">\n        <div class=\"center black-text\">\n          Sara is the VP of Sales of our FakeTech.io, and she is always looking for a big sale! She loves to go to concerts and run marathons!\n        </div>\n      </div>\n      <div class=\"col s2\">\n        <img src=\"https://www.shareicon.net/data/256x256/2016/05/24/770098_people_512x512.png\" alt=\"\" class=\"circle responsive-img\"> <!-- notice the \"circle\" class -->\n      </div>\n    </div>\n  </div>\n  <div class=\"card-panel grey lighten-5 z-depth-2 hoverable\">\n    <div class=\"row valign-wrapper\">\n      <div class=\"col s2\">\n        <img src=\"https://www.shareicon.net/data/256x256/2016/05/24/770100_people_512x512.png\" alt=\"\" class=\"circle responsive-img\"> <!-- notice the \"circle\" class -->\n      </div>\n      <div class=\"col s10\">\n        <div class=\"center black-text\">\n          Janet is the VP of Marketing of FakeTech.io, and she has a pet dog named Sparky. She loves her dog and picnics!\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
        "CSS": "body {\n  background-color: #ACACAC;\n}",
