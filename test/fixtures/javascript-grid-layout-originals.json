    {
      "project": "my-javascript-art-part-3",
      "role": "reference",
      "url": "https://codepen.io/junilearning/pen/4735eaf3e168cfb944a3daad063e287c",
      "observedURL": "https://codepen.io/junilearning/pen/yLeOgMQ",
      "title": "JSS13 Project 4: My JavaScript Art pt III",
      "panels": {
        "HTML": "<div class=\"section pink\">\n  <h1 class=\"center\">My JavaScript Art</h1>\n</div>\n<div class=\"section grey lighten-2\">\n  <h3 class=\"center\">Project One</h3>\n  <br>\n  <div class=\"row\">\n    <div id=\"rainbow\" class=\"col m12 l7 center\"></div>\n    <div class=\"col l1\"></div>\n    <div class=\"col m12 l3\">\n      <div class=\"card blue-grey darken-1\">\n        <div class=\"card-content white-text\">\n          <span class=\"card-title\">Rainbow</span>\n          <p>This is a project I did in d3 that looks like a rainbow. It fills in with the red arc first, and then continues with all the other colors</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<div class=\"section\">\n  <h3 class=\"center black-text\">Project 2</h3>\n  <br>\n  <div class=\"row\">\n    <div class=\"col l2\"></div>\n    <div class=\"col s4 l3\">\n      <div class=\"card blue-grey darken-1\">\n        <div class=\"card-content white-text\">\n          <span class=\"card-title\">Captain America Shield</span>\n          <p>This is a project I did in d3 that resembles the shield from the hero in the marvel movie</p>\n        </div>\n      </div>\n    </div>\n    <div id=\"shield\" class=\"center col s7 l7\"></div>\n  </div>\n</div>\n<div class=\"section blue\">\n  <h3 class=\"center white-text\">Project 3</h3>\n  <br>\n  <div class=\"row\">\n    <div id=\"pacman\" class=\"col m12 l7 center\"></div>\n    <div class=\"col l1\"></div>\n    <div class=\"col l3\">\n      <div class=\"card blue-grey darken-1\">\n        <div class=\"card-content white-text\">\n          <span class=\"card-title\">Pacman</span>\n          <p>This is a project I did in d3 that looks like two pacmen from the classic arcade game facing each other</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<div class=\"section black\">\n  <h3 class=\"center white-text\">Project 4</h3>\n  <br>\n  <div class=\"row\">\n    <div class=\"col l2\"></div>\n    <div class=\"col s4 l3\">\n      <div class=\"card blue-grey darken-1\">\n        <div class=\"card-content white-text\">\n          <span class=\"card-title\">Snowman</span>\n          <p>This is a project I did in d3 that is of a snowman. I might add buttons in the future</p>\n        </div>\n      </div>\n    </div>\n    <div id=\"snowman\" class=\"center col s7\"></div>\n  </div>\n</div>",
        "CSS": "",
        "JavaScript": "let colors = [\"Red\", \"Orange\", \"Yellow\", \"Green\", \"Blue\", \"Indigo\", \"Violet\"];\n\nlet margin = { top: 30, right: 200, bottom: 50, left: 30, pad: 10 };\nvar width = 800 - margin.left - margin.right;\nvar height = 350 - margin.top - margin.bottom;\n\nlet svg = d3\n  .select(\"#rainbow\")\n  .append(\"svg\")\n  .attr(\"width\", width)\n  .attr(\"height\", height)\n  .append(\"g\")\n  .attr(\"transform\", \"translate(300,300)\");\n\n//Define Arc for rainbow\nlet arc = d3\n  .arc()\n  .innerRadius(function (d, i) {\n    return 300 - 20 * i;\n  })\n  .outerRadius(function (d, i) {\n    return 300 - 20 * i - 20;\n  })\n  .startAngle(function (d, i) {\n    return (-Math.PI / 2) * 0.7;\n  })\n  .endAngle(function (d, i) {\n    return (Math.PI / 2) * 0.7;\n  });\n\n//Adding all colors arc\nlet path = svg\n  .selectAll(\"g.arc\")\n  .data(colors)\n  .enter()\n  .append(\"g\")\n  .attr(\"class\", \"arc\");\n//Adding with animation\npath\n  .append(\"path\")\n  .transition()\n  .delay(function (d, i) {\n    return i * 200;\n  })\n  .duration(150)\n  .attr(\"fill\", function (d, i) {\n    return d;\n  })\n  .attr(\"d\", arc);\n\nlet widthShield = 400;\nlet heightShield = 300;\n\nlet positionX = 200;\nlet positionY = 110;\n\n// Create SVG element to append to\nlet svg2 = d3.select(\"#shield\")\n  .append(\"svg\")\n  .attr(\"width\", widthShield)\n  .attr(\"height\", heightShield);\n\n// Add a large circle at the top\nsvg2.append(\"circle\")\n  .attr(\"fill\", \"red\")\n  .attr(\"cx\", positionX)\n  .attr(\"cy\", positionY)\n  .attr(\"r\", 110);\n\n// Add a medium circle in the middle\nsvg2.append(\"circle\")\n  .attr(\"fill\", \"white\")\n  .attr(\"cx\", positionX)\n  .attr(\"cy\", positionY)\n  .attr(\"r\", 90);\n\n// Add a medium circle in the middle\nsvg2.append(\"circle\")\n  .attr(\"fill\", \"red\")\n  .attr(\"cx\", positionX)\n  .attr(\"cy\", positionY)\n  .attr(\"r\", 70);\n\n// Add a small circle to the top\nsvg2.append(\"circle\")\n  .attr(\"fill\", \"blue\")\n  .attr(\"cx\", positionX)\n  .attr(\"cy\", positionY)\n  .attr(\"r\", 50);\n\nlet star = d3.symbol().type(d3.symbolStar).size(2000);\n\nsvg2.append(\"path\")\n  .attr(\"d\", star)\n  .attr(\"fill\", \"white\")\n  .attr(\"transform\", `translate(${positionX},${positionY})`);\n\nlet width2 = 500;\nlet height2 = 300;\n\n// Conversion function that should be given to the student at the instructor's discretion\nconst degreesToRadians = (degrees) => (\n  degrees * Math.PI / 180\n);\n\n// Create a new svg to append to\nconst svg3 = d3.select(\"#pacman\")\n  .append(\"svg\")\n  .attr(\"width\", width2)\n  .attr(\"height\", height2);\n\n// Create the object that will generate our curves\nconst arcGenerator = d3.arc();\n\n// Create the arc that will be the left Pac-Man–note the start and end angles, and their difference vs. the right Pac-Man below\nlet leftPacMan = arcGenerator({\n  startAngle: degreesToRadians(120),\n  endAngle: degreesToRadians(430),\n  innerRadius: 0,\n  outerRadius: 100\n});\n\n// Create the arc that will be the right Pac-Man\nlet rightPacMan = arcGenerator({\n  startAngle: -degreesToRadians(120),\n  endAngle: -degreesToRadians(430),\n  innerRadius: 0,\n  outerRadius: 100\n});\n\n// Append the left Pac-Man to the svg\nsvg3.append('path')\n  .attr(\"fill\", \"yellow\")\n  .attr(\"transform\", \"translate(150,110)\")\n\t.attr('d', leftPacMan);\n\n// Append the right Pac-Man to the svg\nsvg3.append('path')\n  .attr(\"fill\", \"yellow\")\n  .attr(\"transform\", \"translate(400,110)\")\n\t.attr('d', rightPacMan);\n\nlet widthSnowman = 300;\nlet heightSnowman = 500;\n\n// Create SVG element to append to\nlet svg4 = d3.select(\"#snowman\")\n  .append(\"svg\")\n  .attr(\"width\", widthSnowman)\n  .attr(\"height\", heightSnowman);\n\n// Add a small circle to the top\nsvg4.append(\"circle\")\n  .attr(\"fill\", \"white\")\n  .attr(\"cx\", 150)\n  .attr(\"cy\", 50)\n  .attr(\"r\", 50);\n\n// Left eye\nsvg4.append(\"circle\")\n  .attr(\"fill\", \"black\")\n  .attr(\"cx\", 125)\n  .attr(\"cy\", 35)\n  .attr(\"r\", 5);\n\n// Right eye\nsvg4.append(\"circle\")\n  .attr(\"fill\", \"black\")\n  .attr(\"cx\", 175)\n  .attr(\"cy\", 35)\n  .attr(\"r\", 5);\n\nsvg4.append(\"circle\")\n  .attr(\"fill\", \"orange\")\n  .attr(\"cx\", 150)\n  .attr(\"cy\", 50)\n  .attr(\"r\", 5);\n\n// Nose\n\n/*\nCode handling the mouth\n*/\n\n// Generate a path that will be the smile\nlet pathData = arcGenerator({\n  startAngle: degreesToRadians(90),\n  endAngle: degreesToRadians(270),\n  innerRadius: 10,\n  outerRadius: 15\n});\n\n// Append the smile path, moved over 250px in the x and 200px in the y\nsvg4.append('path')\n  .attr(\"fill\", \"black\")\n  .attr(\"transform\", \"translate(150,70)\")\n\t.attr('d', pathData);\n\n// Add a medium circle in the middle\nsvg4.append(\"circle\")\n  .attr(\"fill\", \"white\")\n  .attr(\"cx\", 150)\n  .attr(\"cy\", 160)\n  .attr(\"r\", 70);\n\n// Draw the left arm\nlet leftArm = svg4.append(\"line\")               \n              .attr(\"x1\", 200)\n              .attr(\"x2\", 300)\n              .attr(\"y1\", 160)\n              .attr(\"y2\", 145)\n              .attr(\"stroke-width\", 2)\n              .attr(\"stroke\", \"brown\");\n\n// Draw the right arm\nlet rightArm = svg4.append(\"line\")               \n              .attr(\"x1\", 100)\n              .attr(\"x2\", 0)\n              .attr(\"y1\", 160)\n              .attr(\"y2\", 145)\n              .attr(\"stroke-width\", 2)\n              .attr(\"stroke\", \"brown\");\n\n// Add a large circle at the top\nsvg4.append(\"circle\")\n  .attr(\"fill\", \"white\")\n  .attr(\"cx\", 150)\n  .attr(\"cy\", 300)\n  .attr(\"r\", 100);\n"
      },
