      "title": "JSS13 Project 1: Chessboard Solution",
      "panels": {
        "HTML": "<!--\nMake a chessboard grid with alternating colors in CSS and HTML. Each square should be 1fr tall and 1fr wide, and the board should resize with the size of the container (hint: a trick is to make the width and height of the grid in terms of vh https://www.w3schools.com/cssref/css_units.asp in order to size the grid so that it can resize properly)\n-->\n\n<!-- Solution -->\n\n<div class=\"container\">\n  <div></div>\n  <div class=\"board\">\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n    <div class=\"tile dark\"></div>\n    <div class=\"tile\"></div>\n  </div>\n  <div></div>\n</div>\n",
        "CSS": ".container {\n  display: grid;\n  grid-template-columns: 1fr 90vh 1fr;\n  width: 100%;\n  height: 100%;\n}\n\n.board {\n  width: 90vh;\n  height: 90vh;\n  border: 10px solid #8b6914;\n  display: grid;\n  grid-template: repeat(8, 1fr) / repeat(8, 1fr);\n}\n\n.tile {\n  background-color: #deb887;\n}\n\n.dark {\n  background-color: #8B4513;\n}\n",
