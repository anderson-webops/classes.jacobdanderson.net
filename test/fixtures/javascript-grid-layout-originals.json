    {
      "project": "pokemon-team",
      "role": "reference",
      "url": "https://codepen.io/junilearning/pen/e96eae8cd85c1fe2bbaf3b5cdd046522",
      "observedURL": "https://codepen.io/junilearning/pen/Yzyddow/e96eae8cd85c1fe2bbaf3b5cdd046522",
      "title": "JSS13 Project 3: Pokemon Team Solution",
      "panels": {
        "HTML": "<!-- \nCreate a Pokemon team with images of your favorite pokemon, nicknames of your pokemon, movesets in the form of tables, and pokemon stats with icons representing HP, ATK, DEF, SPA, SPD, and SPE. Your team should display as 2x3 on desktop, 3x2 on tablet, and 6x1 on mobile. Also, add a navigation bar at the top.\n-->\n\n<!-- Solution -->\n\n<nav class=\"grey darken-3\">\n  <div class=\"nav-wrapper\">\n    <div class=\"brand-logo center\">My Pokemon Team</div>\n  </div>\n</nav>\n<br>\n<div class=\"row\">\n  <div class=\"col s12 m6 l4\">\n    <div class=\"card\">\n      <div class=\"card-title center\">\n        Butterfree\n      </div>\n      <hr>\n      <div class=\"card-image\">\n        <img src=\"https://www.serebii.net/swordshield/pokemon/012.png\" alt=\"#\">\n      </div>\n      <div class=\"card-content\">\n        <table class=\"centered\">\n          <thead>\n            <th>HP</th>\n            <th>ATK</th>\n            <th>DEF</th>\n            <th>SPA</th>\n            <th>SPD</th>\n            <th>SPE</th>\n          </thead>\n          <tbody>\n            <tr>\n              <td>324</td>\n              <td>170</td>\n              <td>179</td>\n              <td>251</td>\n              <td>233</td>\n              <td>215</td>\n            </tr>\n          </tbody>\n        </table>\n        <br>\n        <h6 class=\"center\">\n          <strong>\n            Moves\n          </strong>\n        </h6>\n        <table class=\"centered\">\n          <tbody>\n            <tr>\n              <td>Sleep Powder</td>\n              <td>Giga Drain</td>\n            </tr>\n            <tr>\n              <td>Psychic</td>\n              <td>Bug Buzz</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n  <div class=\"col s12 m6 l4\">\n    <div class=\"card\">\n      <div class=\"card-title center\">\n        Tyranitar\n      </div>\n      <hr>\n      <div class=\"card-image\">\n        <img src=\"http