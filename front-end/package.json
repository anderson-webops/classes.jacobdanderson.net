{
	"name": "front-end",
	"version": "2.0.0",
	"description": "",
	"author": "Jacob Anderson",
	"keywords": [],
	"license": "ISC",
	"type": "module",
	"private": true,
	"main": "dist/script.js",
	"scripts": {
		"build": "node scripts/download-code-ide-assets.mjs && vite-ssg build && node scripts/normalize-static-routes.mjs",
		"dev": "vite --port 3333 --open",
		"start": "vite --port 3333 --open --host",
		"serve": "vite --port 3333 --open --host",
		"preview": "vite preview",
		"preview-https": "serve dist",
		"courses:audit": "node ../back-end/node_modules/tsx/dist/cli.mjs scripts/generate-course-development-artifacts.mts",
		"courses:sync-source-readiness": "node ../back-end/node_modules/tsx/dist/cli.mjs scripts/sync-course-source-readiness.mts",
		"test": "npm run test:unit",
		"test:e2e": "cypress open",
		"test:unit": "npm run test:unit:core && npm run test:course-quality",
		"test:unit:core": "vitest run --exclude test/store.courses.quality.spec.test.ts --exclude test/store.courses.implementation-artifacts.spec.test.ts",
		"test:course-quality": "vitest run test/store.courses.implementation-artifacts.spec.test.ts test/store.courses.quality.spec.test.ts --no-file-parallelism --maxWorkers=1",
		"typecheck": "vue-tsc --noEmit",
		"up": "npm exec -- taze major --include-locked",
		"postinstall": "npx simple-git-hooks",
		"lint": "eslint \"src/**/*.{js,ts,vue}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts,vue}\" --fix"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.2",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.8",
		"@codemirror/search": "^6.7.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.2",
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-brands-svg-icons": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@fortawesome/vue-fontawesome": "^3.1.3",
		"@lezer/highlight": "^1.2.5",
		"@unhead/vue": "^3.0.2",
		"@unocss/reset": "^66.13.0",
		"@vue/devtools-api": "^8.2.1",
		"@vueuse/core": "^15.1.0",
		"axios": "^1.20.0",
		"bootstrap": "^5.3.8",
		"dompurify": "^3.4.17",
		"fflate": "^0.8.3",
		"follow-redirects": "^1.16.2",
		"leaflet": "^1.9.4",
		"markdown-it": "^14.3.3",
		"nprogress": "^0.2.0",
		"pinia": "^4.1.0",
		"vite-plugin-pages": "^0.33.3",
		"vite-plugin-vue-layouts-next": "^3.3.1",
		"vue": "^3.5.46",
		"vue-demi": "^0.14.10",
		"vue-i18n": "^11.4.17",
		"vue-router": "^5.5.3",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@iconify-json/carbon": "^1.2.20",
		"@types/bootstrap": "^5.2.10",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^26.6.11",
		"@types/nprogress": "^0.2.3",
		"@vitejs/plugin-vue": "^6.0.11",
		"beasties": "^0.5.7",
		"cross-env": "^10.1.0",
		"cypress": "^15.15.0",
		"eslint-plugin-format": "^2.0.1",
		"glob": "^14.0.3",
		"lint-staged": "^16.4.0",
		"rolldown": "^1.3.4",
		"rollup": "^4.68.9",
		"simple-git-hooks": "^2.13.1",
		"unocss": "^66.13.0",
		"unplugin-auto-import": "^21.0.0",
		"unplugin-vue-components": "^32.0.0",
		"vite": "^8.4.0",
		"vite-ssg": "^28.3.0",
		"vite-ssg-sitemap": "^0.11.1",
		"vitest": "^4.1.12",
		"vue-eslint-parser": "^10.4.0",
		"vue-tsc": "^3.3.14"
	},
	"optionalDependencies": {
		"@oxc-parser/binding-linux-arm64-gnu": "^0.140.0",
		"@oxc-resolver/binding-linux-arm64-gnu": "^11.17.0",
		"@rollup/rollup-linux-arm64-gnu": "^4.68.9"
	},
	"resolutions": {
		"unplugin": "^3.0.0",
		"vite": "^8.4.0",
		"vue-router": "^5.5.3"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{ts,js,vue}": [
			"eslint --fix"
		]
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead",
		"not ie 11"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anderson-webops/classes.jacobdanderson.net"
	},
