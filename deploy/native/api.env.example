# Root-owned mode 0600. Use exactly one reviewed Mongo credential source.
MONGODB_URI=
SESSION_SECRET=
CROSS_SITE=false
ALLOWED_REQUEST_ORIGINS=https://classes.jacobdanderson.net
PASSWORD_RESET_ORIGIN=https://classes.jacobdanderson.net
AUTH_ORIGIN=https://classes.jacobdanderson.net
INTERNAL_DIAGNOSTICS_KEY=
# Optional machine access to metadata-only session-note verification.
# A separate random credential is required; this is its SHA-256, not the token.
SESSION_NOTES_READ_TOKEN_SHA256=
SESSION_NOTES_READ_TOKEN_EXPIRES_AT=
RATE_LIMIT_STORE=mongo
REQUIRE_ROLE_TRANSFER_TRANSACTIONS=false

# Optional Vault alternative. A partial Vault configuration fails closed.
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/classes/mongodb

# Keep provider sign-in off unless every provider value and policy prerequisite
# has been reviewed. Copy any required mail settings from back-end/.env.EXAMPLE.
OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_BASE64=
