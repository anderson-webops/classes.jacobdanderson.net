{
	"name": "back-end",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "vitest run",
		"start": "node -r dotenv/config dist/server.js",
		"build": "node scripts/run-typescript.mjs -p tsconfig.json",
		"typecheck": "node scripts/run-typescript.mjs -p tsconfig.json --noEmit",
		"watch": "node scripts/run-typescript.mjs -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"up": "npm exec -- taze major --include-locked",
		"lint": "eslint \"src/**/*.{js,ts}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" --fix",
		"create-admin": "node dist/create-admin-user.js",
		"create-admin-ts": "tsx -r dotenv/config src/create-admin-user.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"argon2": "^0.45.2",
		"body-parser": "^2.4.0",
		"connect-mongo": "^6.0.0",
		"cookie-session": "^2.1.1",
		"dotenv": "^18.0.10",
		"esbuild": "^0.28.2",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.5",
		"express-validator": "^7.3.2",
		"helmet": "^8.1.0",
		"imapflow": "^2.12.2",
		"jose": "^6.2.18",
		"marked": "^18.3.0",
		"moment": "^2.31.0",
		"mongoose": "^9.13.1",
		"multer": "^2.5.0",
		"nodemailer": "^10.6.1",
		"openid-client": "^6.9.1",
		"readline-sync": "^1.4.10",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@types/body-parser": "^2.2.0",
		"@types/cookie-session": "^2.0.49",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.18.2",
		"@types/node": "^26.6.11",
		"@types/nodemailer": "^8.0.2",
		"@types/readline-sync": "^1.4.8",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.2",
		"picomatch": "file:../vendor/classes-picomatch-4.0.7-classes.1.tgz"
	},
	"overrides": {
		"minimatch": "11.0.2",
		"body-parser": "$body-parser",
		"brace-expansion": "5.0.12",
		"esbuild": "$esbuild",
		"ip-address": "10.7.4",
		"js-yaml": "4.3.1",
		"nanoid": "3.3.18",
		"postcss": "8.5.24",
		"qs": "6.16.1",
		"proxy-addr": "2.0.8",
		"source-map-js": "1.2.2",
		"vite": "8.1.6",
		"picomatch": "$picomatch"
	}
}
