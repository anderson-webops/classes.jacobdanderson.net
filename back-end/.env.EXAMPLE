# EXAMPLE .env
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OR
# openssl rand -base64 64
# If MongoDB auth is enabled, load credentials from your local secret store.
# Configure this URI only when Vault is not configured. Once a Vault address
# or AppRole setting is supplied, incomplete credentials or a Vault failure
# stop startup rather than silently falling back to this separate credential.
MONGODB_URI="mongodb://localhost:27017/DB_NAME_HERE"
# Production requires at least 32 UTF-8 bytes.
SESSION_SECRET=
# Use only the literal true or false; invalid values stop startup.
CROSS_SITE=false
PORT=3008
# The canonical same-host Nginx deployment should keep the backend on loopback.
# Set this explicitly only when a different network topology requires it.
HOST=127.0.0.1

# Requests normally arrive from a same-host Nginx reverse proxy. Keep the
# default loopback trust boundary unless the proxy topology is explicitly
# different.
TRUST_PROXY=loopback
# Required for /_dbinfo in every environment. Leave unset to disable access.
# Optional. Leave unset to disable internal diagnostics; otherwise use at
# least 32 UTF-8 bytes of random secret material.
INTERNAL_DIAGNOSTICS_KEY=
ALLOWED_REQUEST_ORIGINS=https://classes.jacobdanderson.net

# Promotion and demotion always reject with 503 on standalone MongoDB. Set this
# to true after converting production to a replica set if deployment readiness
# should also fail whenever transactions are unavailable.
REQUIRE_ROLE_TRANSFER_TRANSACTIONS=false
# Optional, test-only replica-set URI used by the native transaction integration
# test. Never point this at a production database.
MONGODB_REPLICA_SET_TEST_URI=

# Production rate limits use MongoDB by default so multiple API processes share
# counters. Set to "memory" only for a single-process local environment.
RATE_LIMIT_STORE=mongo
# Coarse pre-parser limits are intentionally sized for a shared school network
# with roughly 40 active editors. Per-account project limits provide the
# narrower abuse boundary without making every student consume one IP bucket.
API_INGRESS_RATE_WINDOW_MS=900000
API_INGRESS_RATE_MAX=30000
CODE_IDE_PROJECT_INGRESS_RATE_WINDOW_MS=900000
CODE_IDE_PROJECT_INGRESS_RATE_MAX=18000
CODE_IDE_PROJECT_DATA_RATE_WINDOW_MS=900000
CODE_IDE_PROJECT_DATA_RATE_MAX=600
CODE_IDE_PROJECT_ACCOUNT_RATE_WINDOW_MS=900000
CODE_IDE_PROJECT_ACCOUNT_RATE_MAX=1800
CODE_IDE_HEAVY_PROJECT_RATE_WINDOW_MS=900000
CODE_IDE_HEAVY_PROJECT_RATE_MAX=20
# The 80 MB parser ceiling safely admits the controller's valid 12,000,000
# character project maximum even when JSON escaping expands control characters.
# Compressed project request bodies are rejected.
CODE_IDE_PROJECT_BODY_LIMIT=80mb
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=30
LOGIN_ACCOUNT_RATE_WINDOW_MS=900000
LOGIN_ACCOUNT_RATE_MAX=10
SIGNUP_RATE_WINDOW_MS=3600000
SIGNUP_RATE_MAX=5
EMAIL_CHECK_RATE_WINDOW_MS=900000
EMAIL_CHECK_RATE_MAX=30
CODE_IDE_PROJECTS_PER_ACCOUNT_MAX=200
SECURITY_AUDIT_KEY=
SHUTDOWN_TIMEOUT_MS=10000

# Public origin used in emailed password-reset links.
PASSWORD_RESET_ORIGIN=https://classes.jacobdanderson.net
PASSWORD_RESET_RATE_WINDOW_MS=900000
PASSWORD_RESET_RATE_MAX=5
PASSWORD_RESET_ACCOUNT_RATE_WINDOW_MS=3600000
PASSWORD_RESET_ACCOUNT_RATE_MAX=3

# Canonical public origin for OAuth callbacks. Do not derive this from request
# headers. Provider buttons stay hidden unless OAuth is explicitly enabled and
# every required value for that provider is set.
AUTH_ORIGIN=https://classes.jacobdanderson.net
OAUTH_ENABLED=false
OAUTH_RATE_WINDOW_MS=900000
OAUTH_RATE_MAX=30

# Google OAuth 2.0 Web application:
# https://classes.jacobdanderson.net/api/accounts/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sign in with Apple Web configuration (APPLE_OAUTH_CLIENT_ID is the Services ID):
# https://classes.jacobdanderson.net/api/accounts/oauth/apple/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# Preferred: base64 of the complete .p8 private key, including PEM markers.
APPLE_OAUTH_PRIVATE_KEY_BASE64=
# Alternative for local use only; encode line breaks as \n.
APPLE_OAUTH_PRIVATE_KEY=

VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/classes/mongodb

MDMAIL_PRIMARY_FROM=classes@jacobdanderson.net
MDMAIL_FALLBACK_FROM=jacobdanderson@gmail.com
# Legacy sender overrides still read for backwards compatibility.
MDMAIL_FROM_PRIMARY=
MDMAIL_FROM_FALLBACK=
MDMAIL_FROM=
MDMAIL_ALLOW_TO=
MDMAIL_MAX_MD_LEN=200000
ADMIN_MAIL_RECIPIENTS_JSON='[{"name":"Recipient Label","emails":["primary@example.invalid","cc@example.invalid"]}]'
# Optional alternative to ADMIN_MAIL_RECIPIENTS_JSON:
# ADMIN_MAIL_RECIPIENTS_FILE=/secure/path/admin-mail-recipients.json

SMTP_PRIMARY_HOST=127.0.0.1
SMTP_PRIMARY_PORT=25
SMTP_PRIMARY_SECURE=false
SMTP_PRIMARY_SERVERNAME=mail.stridewithus.co
SMTP_PRIMARY_CA_FILE=

SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_SERVERNAME=smtp.gmail.com
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_CA_FILE=

IMAP_APPEND_HOST=mail.stridewithus.co
IMAP_APPEND_PORT=993
IMAP_APPEND_SECURE=true
IMAP_APPEND_SERVERNAME=mail.stridewithus.co
IMAP_APPEND_USER=jacob@jacobdanderson.net
IMAP_APPEND_PASS=
IMAP_SENT_MAILBOX=Sent Messages

# Legacy single-transport settings still read as the primary transport
# when SMTP_PRIMARY_* is unset.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SERVERNAME=
SMTP_USER=
SMTP_PASS=
SMTP_CA_FILE=
