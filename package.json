{
	"name": "classes-monorepo",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.0.1",
	"engines": {
		"node": ">=24.18.0 <27",
		"npm": ">=12.0.1 <13"
	},
	"description": "Monorepo for Classes project",
	"author": "Jacob Anderson",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"audit": "npm audit --workspaces",
		"audit:static-media": "node scripts/audit-static-course-media.mjs",
		"audit-fix": "npm audit fix --workspaces",
		"build": "npm run -w front-end build && npm run -w back-end build",
		"check:dependencies": "npm ls --all",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"test:native-deployment": "node --test test/native-production-deployment.test.mjs",
		"test:native-nginx": "node test/native-nginx-fixture.mjs",
		"test:static-media-fetch": "node --test test/static-media-fetch.test.mjs",
		"a11y": "node scripts/a11y-smoke.mjs",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run -w front-end lint && npm run -w back-end lint",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"clean": "node scripts/clean-generated.mjs",
		"up": "npm exec -- taze major --include-locked --recursive",
		"verify:native-release": "node scripts/verify-native-release.mjs",
		"verify:production": "node scripts/production-security-headers-smoke.mjs && node scripts/production-ide-smoke.mjs && node scripts/production-graph-sketcher-smoke.mjs"
	},
	"overrides": {
		"defu": "6.1.6",
		"eslint-plugin-import": {
			"minimatch": "^3.1.5"
		},
		"brace-expansion": "5.0.8",
		"glob": "13.0.6",
		"@vue/language-core": {
			"minimatch": "^9.0.9"
		},
		"path-to-regexp": "8.4.2",
		"serialize-javascript": "7.0.5",
		"picomatch": "4.0.5",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"@rollup/plugin-babel": {
			"@rollup/pluginutils": {
				"picomatch": "2.3.2"
			}
		},
		"@rollup/plugin-replace": {
			"@rollup/pluginutils": {
				"picomatch": "2.3.2"
			}
		},
		"vue-i18n": "^11.3.0",
		"vite": "^8.0.8",
		"vue-router": "^5.0.4",
		"undici": "7.28.0",
		"follow-redirects": "1.16.0",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.15.3"
		}
	},
	"allowScripts": {
		"connect-mongo": false,
		"express-rate-limit": false,
		"argon2": true,
		"cypress": true,
		"esbuild": true,
		"puppeteer": true,
		"simple-git-hooks": true,
		"vue-demi": true
	},
	"devDependencies": {
		"@antfu/eslint-config": "^8.2.0",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@unocss/eslint-plugin": "^66.6.7",
		"@vue/test-utils": "^2.4.11",
		"axe-core": "^4.11.4",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"puppeteer": "^24.43.1",
		"taze": "^19.11.0",
		"typescript": "^6.0.3"
	}
}
